<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live Update du mode courses (#10 §9) : demandée à l'entrée du premier mode courses, facultative. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Promotion en Live Update (Android 16+), permission sans dialogue. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Mêmes valeurs que :app, pour que le module soit sûr par lui-même (Sonar S6358, S5332). -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false">
        <!-- « Cocher le suivant » et notification écartée : seule la notification de l'app l'appelle. -->
        <receiver
            android:name=".live.LiveUpdateReceiver"
            android:exported="false" />
    </application>
</manifest>
