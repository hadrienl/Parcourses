<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ParcoursesApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- WorkManager démarre à la demande (ParcoursesApp fournit sa configuration et sa fabrique). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          `singleTop` : un lien de la Live Update arrive dans l'activité ouverte (onNewIntent), sans la doubler. Un lien
          ouvert par une autre app sans FLAG_ACTIVITY_NEW_TASK crée l'activité dans la tâche de cette app : elle le
          relaie aussitôt vers la tâche de Parcourses et se ferme (MainActivity.relayToOwnTask, #120). Pas de
          `singleTask` : toucher l'icône fermerait le sélecteur de partage et les dialogues d'autorisation.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Live Update : parcourses://shopping/<visitId> (#10 §8.1). Pas BROWSABLE : aucun site ne l'ouvre. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="parcourses"
                    android:host="shopping" />
            </intent-filter>
            <!--
              Invitation (#87) : parcourses://invitation#<jeton>, ouvert depuis un e-mail ou le bouton « Ouvrir dans
              l'app » de la page /i/ (BROWSABLE). Les liens https passent par l'alias InvitationAppLinks ci-dessous.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="parcourses"
                    android:host="invitation" />
            </intent-filter>
        </activity>

        <!--
          App Links des invitations (#87, lot 87.7) : https://<hôte>/i/#<jeton>, vérifiés par
          https://<hôte>/.well-known/assetlinks.json (docs/site.md). Hôte : `parcourses.invitationHost`, le même que
          BuildConfig.INVITATION_HOST. Un alias et non un filtre de MainActivity, pour qu'un hôte vide coupe le https :
          l'alias est alors désactivé, sans autoVerify, sur un hôte réservé qui ne répond jamais (`.invalid`).
          Chemin exact `/i/` (`path`, pas `pathPrefix`) : /i/invitation.js ou /i/autre restent au navigateur. Le
          fragment et la requête ne comptent pas pour le filtre : MainActivity relit le lien (parseInvitationLink).
        -->
        <activity-alias
            android:name=".InvitationAppLinks"
            android:enabled="${invitationAppLinks}"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter android:autoVerify="${invitationAppLinks}">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${invitationHost}"
                    android:path="/i/" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
