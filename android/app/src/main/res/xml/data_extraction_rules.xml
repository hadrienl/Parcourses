<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. Tout le dossier `datastore/` (session chiffrée, dernier compte, fichiers temporaires `.tmp`) et le jeu de clés Tink ne suivent ni la sauvegarde ni le
    transfert d'appareil : la clé maîtresse du Keystore reste sur l'appareil, une session restaurée serait illisible.
    Une restauration redemande une session anonyme (nouveau compte) : comportement accepté au MVP (#10, §6).
    Le drapeau de suppression du compte (`account_deletion.xml`, #68) ne suit pas non plus : restauré ailleurs, il y
    bloquerait la synchronisation et lancerait une purge que personne n'a demandée.
    Les noms sont vérifiés contre SessionStorageFiles et SharedPreferencesAccountDeletionFlag par BackupRulesTest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="parcourses_tink_keyset.xml" />
        <exclude domain="sharedpref" path="account_deletion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="parcourses_tink_keyset.xml" />
        <exclude domain="sharedpref" path="account_deletion.xml" />
    </device-transfer>
</data-extraction-rules>
