# Application et compte de service Google Play (#12). La clé JSON du compte de service reste hors du dépôt.
# Chemin par défaut : ~/.config/parcourses/play-service-account.json, surchargeable par PARCOURSES_PLAY_JSON_KEY.
json_key_file(ENV.fetch("PARCOURSES_PLAY_JSON_KEY", File.expand_path("~/.config/parcourses/play-service-account.json")))
package_name("fr.parcourses.app")
