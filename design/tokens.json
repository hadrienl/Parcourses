{
  "$description": "Parcourses, direction A « Le Fil » (proposition, non validée). Les noms sont communs à iOS et Android.",
  "color": {
    "light": {
      "surface": "#FBF8F3",
      "surfaceRaised": "#EFE9DF",
      "text": "#1D1B18",
      "textMuted": "#6B645A",
      "brand": "#C8371D",
      "onBrand": "#FFFFFF",
      "thread": "#C8371D",
      "threadIdle": "#EFE9DF",
      "threadUnknown": "#9C948A",
      "success": "#2F7D4F",
      "warning": "#A35F00",
      "danger": "#B3261E"
    },
    "dark": {
      "surface": "#141210",
      "surfaceRaised": "#25211D",
      "text": "#F3EEE6",
      "textMuted": "#A89F92",
      "brand": "#FF6A4D",
      "onBrand": "#2A0A03",
      "thread": "#FF6A4D",
      "threadIdle": "#25211D",
      "threadUnknown": "#6E665C",
      "success": "#6FD39A",
      "warning": "#F2B65A",
      "danger": "#FFB4AB"
    },
    "$contrast": "brand/surface clair 5,3:1 ; textMuted/surface clair 5,6:1 ; brand/surface sombre 6,9:1 (AA texte normal)."
  },
  "typography": {
    "display":  { "size": 56, "weight": 800, "tracking": -0.04, "use": "compteur « restants »", "ios": "Font.system(size:56, weight:.heavy, design:.default)", "compose": "displayLarge (Roboto Flex 800)" },
    "title":    { "size": 30, "weight": 800, "tracking": -0.02, "ios": ".largeTitle.weight(.heavy)", "compose": "headlineLarge" },
    "itemNext": { "size": 20, "weight": 700, "ios": ".title3.bold()", "compose": "titleLarge" },
    "item":     { "size": 17, "weight": 400, "ios": ".body", "compose": "bodyLarge" },
    "aisle":    { "size": 11, "weight": 700, "tracking": 0.08, "case": "upper", "ios": ".caption2.bold()", "compose": "labelSmall" },
    "caption":  { "size": 13, "weight": 400, "ios": ".footnote", "compose": "bodyMedium" },
    "$note": "Toutes les tailles suivent Dynamic Type et l'échelle de police Android (jusqu'à 200 %)."
  },
  "space": { "xxs": 4, "xs": 8, "s": 12, "m": 16, "l": 24, "xl": 32, "threadGutter": 30 },
  "size": { "rowMin": 48, "touchMin": { "ios": 44, "android": 48 }, "bead": 20, "threadWidth": 3, "primaryAction": 56 },
  "radius": { "s": 8, "m": 16, "l": 22, "xl": 28, "pill": 999, "$android": "Échelle M3 : bead = shapes.small → MaterialShapes.Cookie4Sided à la coche" },
  "motion": {
    "check":     { "ios": "spring(response:0.25, dampingFraction:0.8)", "compose": "MotionScheme.standard().fastSpatialSpec()", "ms": 250 },
    "threadAdvance": { "ios": "spring(response:0.35, dampingFraction:0.9)", "compose": "spring(dampingRatio=0.9f, stiffness=Spring.StiffnessMediumLow)", "ms": 350 },
    "reorder":   { "ios": "spring(response:0.4, dampingFraction:1.0)", "compose": "Modifier.animateItem(placementSpec = spring(dampingRatio=1f, stiffness=StiffnessMediumLow))", "ms": 400, "delayAfterCheckMs": 600 },
    "undoBannerMs": 4000,
    "celebration": { "ios": "spring(response:0.6, dampingFraction:0.7)", "compose": "MotionScheme.expressive().defaultSpatialSpec()", "ms": 700 },
    "reduced": { "all": "fondu 150 ms, aucun déplacement" }
  },
  "haptics": {
    "check":   { "ios": "sensoryFeedback(.success)", "android": "HapticFeedbackConstants.CONFIRM" },
    "uncheck": { "ios": "sensoryFeedback(.impact(weight:.light))", "android": "HapticFeedbackConstants.REJECT" },
    "finish":  { "ios": "sensoryFeedback(.success)", "android": "HapticFeedbackConstants.CONFIRM" }
  },
  "material": {
    "ios26": "glassEffect(.regular) sur la barre de saisie, l'indicateur magasin et « Terminer » ; tint(brand) sur « Terminer » uniquement",
    "ios18": ".regularMaterial",
    "reduceTransparency": "surfaceRaised opaque + bordure 1 pt textMuted à 30 %",
    "android": "HorizontalFloatingToolbar + FAB, couleur dynamique activable ; repli sur la palette ci-dessus"
  }
}
