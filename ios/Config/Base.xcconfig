// Réglages communs à toutes les cibles.
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
TARGETED_DEVICE_FAMILY = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
APP_GROUP_ID = group.app.parcourses
// Environnement Supabase : surchargé par Local.xcconfig ou Cloud.xcconfig.
SUPABASE_URL =
SUPABASE_PUBLISHABLE_KEY =
#include? "Local.xcconfig"
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
// Simulateur : signature ad hoc, sans certificat. Sans elle, le Keychain renvoie -34018.
CODE_SIGN_STYLE[sdk=iphonesimulator*] = Manual
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -
